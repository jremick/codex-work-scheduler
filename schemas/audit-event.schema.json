{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-work-scheduler/schemas/audit-event-v1.json",
  "title": "Redacted audit event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence", "event_id", "occurred_at", "event_type", "actor", "details",
    "previous_hash", "event_hash"
  ],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "number", "minimum": 0},
    "event_type": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "details": {"type": "object"},
    "previous_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
