{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-work-scheduler/schemas/quota-guard-session-v1.json",
  "title": "Quota guard public session read model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "guard_id", "state", "threshold_remaining_percent",
    "check_interval_seconds", "target_count", "next_check_at", "last_checked_at",
    "reason_code", "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "guard_id": {"$ref": "config.schema.json#/$defs/identifier"},
    "state": {
      "enum": ["ARMED", "STOPPING", "HELD_QUOTA", "RESUMING", "NEEDS_REVIEW", "DISARMED"]
    },
    "threshold_remaining_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "check_interval_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
    "target_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "next_check_at": {"type": ["number", "null"], "minimum": 0},
    "last_checked_at": {"type": ["number", "null"], "minimum": 0},
    "reason_code": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "created_at": {"type": "number", "minimum": 0},
    "updated_at": {"type": "number", "minimum": 0}
  }
}
